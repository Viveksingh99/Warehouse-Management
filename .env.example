# API base URL consumed by Vite (or API_BASE_URL / REACT_APP_API_BASE_URL)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional dev server host/port
HOST=127.0.0.1
PORT=5173

# Playwright local E2E testing variables (never commit real hosted passwords)
UI_BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:8000
EVAL_ADMIN_USERNAME=demo_admin
EVAL_ADMIN_PASSWORD=replace-with-local-test-password
EVAL_AUDITOR_USERNAME=demo_auditor
EVAL_AUDITOR_PASSWORD=replace-with-local-test-password
EVAL_TECHNICIAN_USERNAME=demo_technician
EVAL_TECHNICIAN_PASSWORD=replace-with-local-test-password
